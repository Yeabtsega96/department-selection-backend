generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 String    @id
  name               String    @db.Text
  email              String
  emailVerified      Boolean   @default(false)
  image              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  username           String?
  role               String    @default("STUDENT") @db.VarChar(50)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  banned             Boolean   @default(false)
  banReason          String?   @db.Text
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]

  // Application profile relationships
  employeeProfile EmployeeProfile?
  studentProfile  StudentProfile?

  // Permission relationships
  permissionGrants   UserPermissionGrant[] @relation("GrantedUserPermissions")
  permissionsGranted UserPermissionGrant[] @relation("PermissionGrantor")
  permissionsRevoked UserPermissionGrant[] @relation("PermissionRevoker")

  // Department head assignments
  departmentHeadAssignments     DepartmentHeadAssignment[]  @relation("DepartmentHead")
  departmentHeadAssignmentsMade DepartmentHeadAssignment[]  @relation("DepartmentHeadAssigner")
  proposedDepartmentConfigs     DepartmentSelectionConfig[] @relation("ConfigProposer")

  approvedDepartmentConfigs DepartmentSelectionConfig[] @relation("ConfigApprover")

  departmentConfigRevisions DepartmentSelectionConfigRevision[] @relation("ConfigRevisionActor")

  // Audit relationship
  auditLogs AuditLog[] @relation("AuditLogActor")

  selectionPeriodsCreated SelectionPeriod[]       @relation("SelectionPeriodCreator")
  gpaRecordsRecorded      StudentAcademicRecord[] @relation("GPARecordRecorder")

  gpaCorrectionsMade StudentAcademicRecordCorrection[] @relation("GPARecordCorrector")

  qualificationsVerified StudentQualification[] @relation("QualificationVerifier")

  @@unique([email])
  @@unique([username])
  @@index([role])
  @@index([isActive])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model EmployeeProfile {
  id         String @id @default(cuid())
  userId     String @unique
  employeeId String @unique

  phone    String?
  jobTitle String?
  office   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profile")
}

model StudentProfile {
  id                  String @id @default(cuid())
  userId              String @unique
  universityStudentId String @unique

  gender   Gender
  regionId String

  enrollmentYear Int
  studentStatus  StudentStatus     @default(ACTIVE)
  emailType      StudentEmailType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  region          Region                  @relation(fields: [regionId], references: [id])
  academicRecords StudentAcademicRecord[]
  qualifications  StudentQualification[]

  @@index([regionId])
  @@index([studentStatus])
  @@index([enrollmentYear])
  @@map("student_profile")
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  INACTIVE
}

enum StudentEmailType {
  UNIVERSITY
  PERSONAL
}

model Region {
  id                 String  @id @default(cuid())
  code               String  @unique
  name               String
  isDevelopingRegion Boolean @default(false)
  isActive           Boolean @default(true)

  students  StudentProfile[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("region")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]

  @@map("permission")
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String

  createdAt DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permission")
}

enum UserRole {
  ADMIN
  DEAN
  COORDINATOR
  DEPARTMENT_HEAD
  STUDENT
}

model UserPermissionGrant {
  id String @id @default(cuid())

  userId       String
  permissionId String

  grantedBy String
  reason    String

  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  revokedAt DateTime?
  revokedBy String?

  user User @relation("GrantedUserPermissions", fields: [userId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  grantor User @relation("PermissionGrantor", fields: [grantedBy], references: [id], onDelete: Restrict)

  revoker User? @relation("PermissionRevoker", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@index([userId, permissionId])
  @@index([expiresAt])
  @@index([grantedBy])
  @@map("user_permission_grant")
}

model AuditLog {
  id String @id @default(cuid())

  actorId    String?
  action     String
  entityType String
  entityId   String

  oldData Json?
  newData Json?

  reason    String?
  ipAddress String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Campus {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  location    String?
  description String? @db.Text
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]

  @@map("campus")
}

model Department {
  id   String @id @default(cuid())
  code String @unique
  name String

  description String? @db.Text
  vision      String? @db.Text
  mission     String? @db.Text
  objectives  String? @db.Text

  campusId String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)

  headAssignments  DepartmentHeadAssignment[]
  selectionConfigs DepartmentSelectionConfig[]

  @@index([campusId])
  @@index([isActive])
  @@map("department")
}

enum DepartmentChangeType {
  CODE_CHANGED
  NAME_CHANGED
  CAMPUS_CHANGED
}

model DepartmentHeadAssignment {
  id           String @id @default(cuid())
  departmentId String
  userId       String
  assignedBy   String

  assignmentType DepartmentHeadType
  status         AssignmentStatus   @default(ACTIVE)

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  user User @relation("DepartmentHead", fields: [userId], references: [id], onDelete: Restrict)

  assigner User @relation("DepartmentHeadAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([departmentId, status])
  @@index([userId, status])
  @@index([assignedBy])
  @@map("department_head_assignment")
}

enum DepartmentHeadType {
  PRIMARY
  ACTING
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

model AcademicYear {
  id        String             @id @default(cuid())
  name      String             @unique
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionPeriods       SelectionPeriod[]
  studentAcademicRecords StudentAcademicRecord[]

  @@index([status])
  @@map("academic_year")
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model StudentGroup {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionPeriods SelectionPeriod[]

  @@map("student_group")
}

model SelectionPeriod {
  id             String @id @default(cuid())
  academicYearId String
  studentGroupId String

  name        String
  type        SelectionPeriodType
  description String?

  status SelectionPeriodStatus @default(DRAFT)

  // Student preference schedule
  preferenceStartDate DateTime?
  preferenceEndDate   DateTime?

  // Late preference schedule
  latePreferenceStartDate DateTime?
  latePreferenceEndDate   DateTime?

  // Student reconsideration schedule
  reconsiderationStartDate DateTime?
  reconsiderationEndDate   DateTime?

  // Selection configuration
  maxPreferences       Int @default(3)
  maxPreferenceUpdates Int @default(3)

  // GPA collection required for allocation
  requiredGpaStage GpaCollectionStage

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  studentGroup StudentGroup @relation(fields: [studentGroupId], references: [id], onDelete: Restrict)

  creator User @relation("SelectionPeriodCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  departmentConfigs DepartmentSelectionConfig[]

  @@index([academicYearId, status])
  @@index([studentGroupId])
  @@index([createdBy])
  @@map("selection_period")
}

enum SelectionPeriodType {
  REGULAR
  ADDITIONAL
  SPECIAL
}

enum SelectionPeriodStatus {
  DRAFT
  UPCOMING
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum GpaCollectionStage {
  FIRST_COLLECTION
  SECOND_COLLECTION
}

model DepartmentSelectionConfig {
  id                String @id @default(cuid())
  selectionPeriodId String
  departmentId      String

  proposedCapacity Int
  approvedCapacity Int?

  femaleQuotaPercentage Decimal @default(0) @db.Decimal(5, 2)

  status ConfigApprovalStatus @default(DRAFT)

  proposedBy String
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectionPeriod SelectionPeriod @relation(fields: [selectionPeriodId], references: [id], onDelete: Restrict)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  proposer User @relation("ConfigProposer", fields: [proposedBy], references: [id], onDelete: Restrict)

  approver User? @relation("ConfigApprover", fields: [approvedBy], references: [id], onDelete: Restrict)

  revisions               DepartmentSelectionConfigRevision[]
  eligibilityRequirements DepartmentEligibilityRequirement[]

  @@unique([selectionPeriodId, departmentId])
  @@index([status])
  @@map("department_selection_config")
}

enum ConfigApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model DepartmentSelectionConfigRevision {
  id       String @id @default(cuid())
  configId String

  version Int

  proposedCapacity Int
  approvedCapacity Int?

  femaleQuotaPercentage Decimal @db.Decimal(5, 2)

  eligibilitySnapshot Json

  reason    String?
  changedBy String
  createdAt DateTime @default(now())

  config DepartmentSelectionConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  actor User @relation("ConfigRevisionActor", fields: [changedBy], references: [id], onDelete: Restrict)

  @@unique([configId, version])
  @@index([changedBy])
  @@map("department_selection_config_revision")
}

model DepartmentEligibilityRequirement {
  id       String @id @default(cuid())
  configId String

  requirementGroup  String
  qualificationType QualificationType

  fieldOfStudy String?
  matchingRule QualificationMatchingRule

  isMandatory Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  config DepartmentSelectionConfig @relation(fields: [configId], references: [id], onDelete: Restrict)

  @@index([configId])
  @@map("department_eligibility_requirement")
}

enum QualificationType {
  DIPLOMA
  LEVEL_IV
  OTHER
}

enum QualificationMatchingRule {
  EXACT
  RELATED
  ANY
}

model StudentAcademicRecord {
  id             String @id @default(cuid())
  studentId      String
  academicYearId String

  semester    Semester
  semesterGPA Decimal  @db.Decimal(4, 2)

  recordedBy String
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  recorder User @relation("GPARecordRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  corrections StudentAcademicRecordCorrection[]

  @@unique([studentId, academicYearId, semester])
  @@index([academicYearId, semester])
  @@index([recordedBy])
  @@map("student_academic_record")
}

enum Semester {
  FIRST_SEMESTER
  SECOND_SEMESTER
}

model StudentAcademicRecordCorrection {
  id               String @id @default(cuid())
  academicRecordId String

  oldGPA Decimal @db.Decimal(4, 2)
  newGPA Decimal @db.Decimal(4, 2)

  reason      String
  correctedBy String
  correctedAt DateTime @default(now())

  academicRecord StudentAcademicRecord @relation(fields: [academicRecordId], references: [id], onDelete: Restrict)

  corrector User @relation("GPARecordCorrector", fields: [correctedBy], references: [id], onDelete: Restrict)

  @@index([academicRecordId])
  @@index([correctedBy])
  @@map("student_academic_record_correction")
}



model StudentQualification {
  id                String   @id @default(cuid())
  studentId         String

  qualificationType QualificationType
  title             String
  fieldOfStudy      String?
  institution       String?
  completionYear    Int?

  documentReference String?

  verificationStatus QualificationVerificationStatus @default(PENDING)

  verifiedBy        String?
  verifiedAt        DateTime?
  rejectionReason   String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId],references: [id],onDelete: Restrict)

  verifier User? @relation("QualificationVerifier",fields: [verifiedBy],references: [id],onDelete: Restrict)

  @@index([studentId])
  @@index([verificationStatus])
  @@map("student_qualification")
}

enum QualificationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}
